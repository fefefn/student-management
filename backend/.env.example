# Server
PORT=5000
NODE_ENV=development

# MongoDB connection string
# Local:  mongodb://127.0.0.1:27017/student_management
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/student_management
MONGODB_URI=your_mongodb_connection_string

# JWT
# Generate a strong secret, e.g.  node -e "console.log(require(\"crypto\").randomBytes(48).toString(\"hex\"))"
JWT_SECRET=your_jwt_secret
JWT_EXPIRES_IN=7d

# Frontend origin allowed by CORS (comma-separate multiple origins)
CLIENT_URL=http://localhost:5173
